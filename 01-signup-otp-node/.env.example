# NumberOTP API key (Dashboard → Developer). Starts with notp_
NOTP_API_KEY=

# How the demo app sends SMS: console (print only) or twilio
SMS_TRANSPORT=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A Twilio number or messaging service that can send to the test country
TWILIO_FROM=

# NumberOTP country id for the test number (187 = United States, 16 = United Kingdom)
DEMO_COUNTRY=187
# Spending limits for the end-to-end test
DEMO_MAX_USD_PER_DAY=5
DEMO_MAX_PRICE=1
